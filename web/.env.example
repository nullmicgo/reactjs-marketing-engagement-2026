# Get a token from https://www.sanity.io/manage → project → API → Tokens (Editor permissions).
# Add your dev origin under API → CORS origins (e.g. http://localhost:5173).
# Add this app’s origin for admin too if you use /admin (e.g. http://localhost:5173).
VITE_SANITY_API_TOKEN=

# Optional; defaults to production
# VITE_SANITY_DATASET=production
